TFCTX.v=1

SYS:
  name=TaskForge
  type=local-first-agent-task-control-plane
  runtime=OpenCode+local-llm+repo-tools
  goals=persistent-agent-id,durable-task-state,tool-registry,crash-recovery,idempotent-ops

PRIO:
  1=correctness
  2=state-integrity
  3=crash-recovery
  4=minimal-api
  5=low-context

ENT:
  Agent={id,role,status,last_seen,capabilities}
  Task={id,title,state,owner,lease,inputs,outputs,next_action}
  Tool={id,name,endpoint,capabilities,auth}
  Event={id,type,actor,target,time,payload}

STATE.Task:
  Inbox -> Needs Spec|Rejected
  Needs Spec -> Ready|Deferred
  Ready -> In Progress|Blocked|Deferred
  In Progress -> Review|Verify|Blocked|Deferred
  Review -> In Progress|Verify|Done
  Verify -> In Progress|Review|Done
  Blocked -> Ready|In Progress
  Done=terminal unless explicit recovery
  Rejected=terminal

INV:
  Agent.id stable across restart
  Task.claim atomic
  Task.start requires claim owner
  Task.complete requires started owner
  Heartbeat refreshes lease only by owner
  Duplicate command must be idempotent
  External tool calls must emit Event
  State changes must be auditable
  Review/Verify tasks resume existing worktrees; do not start a new task

REVIEW:
  check=state-transition,lease-race,idempotency,restart-path,api-contract,error-shape
  reject=implicit-session-state,hidden-global-state,non-idempotent-retry,unbounded-context,large-md-load

CTX:
  prefer=.agent/tf.ctx,.agent/spec.idx,docs/workflow.md,changed-files,nearby-tests
  avoid=session-ses_*.md,specs/session-ses_*.md,docs/archive,.opencode/node_modules,Volumes,node_modules

CTX_BUDGET:
  soft_limit=40000
  hard_limit=55000
  action_at_soft_limit=emit compact state and avoid broad reads
  action_at_hard_limit=stop; let OpenCode compact or restart
  max_output_default=500
  max_files_read_default=6
