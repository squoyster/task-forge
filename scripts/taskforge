#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  LINK_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  if [[ "$TARGET" != /* ]]; then
    SOURCE="$LINK_DIR/$TARGET"
  else
    SOURCE="$TARGET"
  fi
done

SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source-first launcher for local checkouts.
# Set TASKFORGE_RUNTIME=dist to force a built CLI when one exists.
if [ "${TASKFORGE_RUNTIME:-source}" = "dist" ] && [ -f "$REPO_ROOT/dist/cli.js" ]; then
  exec node "$REPO_ROOT/dist/cli.js" "$@"
else
  exec node --import "$REPO_ROOT/node_modules/tsx/dist/loader.mjs" "$REPO_ROOT/src/cli.ts" "$@"
fi
