#!/usr/bin/env bash
set -euo pipefail

SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
  TARGET="$(readlink "$SCRIPT_PATH")"
  case "$TARGET" in
    /*) SCRIPT_PATH="$TARGET" ;;
    *) SCRIPT_PATH="$SCRIPT_DIR/$TARGET" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd -P)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source-first launcher for local checkouts.
# Set TASKFORGE_RUNTIME=dist to force a built CLI when one exists.
if [ "${TASKFORGE_RUNTIME:-source}" = "dist" ] && [ -f "$REPO_ROOT/dist/cli.js" ]; then
  exec node "$REPO_ROOT/dist/cli.js" "$@"
else
  exec node --import tsx "$REPO_ROOT/src/cli.ts" "$@"
fi
