{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "TASKFORGE.md",
    "docs/workflow.md"
  ],
  "default_agent": "implementer",
  "agent": {
    "implementer": {
      "description": "Implements one task at a time in isolated worktrees",
      "mode": "primary",
      "env": {
        "TASK_FORGE_ACTIVE": "true"
      }
    },
    "intake": {
      "description": "Converts raw requests into structured task records",
      "mode": "subagent"
    },
    "planner": {
      "description": "Decomposes epics and features into executable tasks",
      "mode": "subagent"
    },
    "reviewer": {
      "description": "Reviews code for correctness, security, and scope compliance",
      "mode": "subagent",
      "permission": {
        "edit": "deny"
      }
    },
    "deps": {
      "description": "Dependency Steward — scans, audits, and plans dependency updates",
      "mode": "subagent"
    },
    "doctor": {
      "permission": {
        "bash": {
          "taskforge doctor *": "allow",
          "taskforge inspect *": "allow",
          "taskforge audit *": "allow",
          "git status *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git fetch *": "allow",
          "git pull *": "ask",
          "git commit *": "ask",
          "git push *": "ask",
          "git reset *": "ask",
          "git rebase *": "ask",
          "git push --force*": "deny"
        }
      }
    }
  },
  "mcp": {
    "taskforge": {
      "type": "local",
      "command": [
        "taskforge",
        "mcp",
        "--config",
        ".taskforge/config.json"
      ],
      "enabled": true
    }
  },
  "permission": {
    "*": "ask",
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "bash.rm": "ask",
    "bash.sudo": "deny",
    "external_directory": {
      "../task-state/**": "allow",
      "../worktrees/**": "allow"
    }
  }
}
