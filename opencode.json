{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "TASKFORCE.md"
  ],
  "default_agent": "implementer",
  "agent": {
    "implementer": {
      "description": "Implements one task at a time in isolated worktrees",
      "mode": "primary",
      "env": {
        "TASK_FORGE_ACTIVE": "true"
      }
    },
    "intake": {
      "description": "Converts raw requests into structured task records",
      "mode": "subagent"
    },
    "planner": {
      "description": "Decomposes epics and features into executable tasks",
      "mode": "subagent"
    },
    "reviewer": {
      "description": "Reviews code for correctness, security, and scope compliance",
      "mode": "subagent",
      "permission": {
        "edit": "deny"
      }
    },
    "deps": {
      "description": "Dependency Steward — scans, audits, and plans dependency updates",
      "mode": "subagent"
    },
    "doctor": {
      "permission": {
        "bash": {
          "taskforge doctor *": "allow",
          "taskforge inspect *": "allow",
          "taskforge audit *": "allow",
          "git status *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git fetch *": "allow",
          "git pull *": "ask",
          "git commit *": "ask",
          "git push *": "ask",
          "git reset *": "ask",
          "git rebase *": "ask",
          "git push --force*": "deny"
        }
      }
    }
  },
  "taskforge": {
    "managed": true,
    "policyVersion": 1,
    "audit": true,
    "guard": true
  },
  "permission": {
    "*": "ask",
    "edit": {
      "*": "allow",
      "../task-state/**": "deny",
      "tasks/**": "deny",
      ".git/**": "deny",
      "../worktrees/**/.git/**": "deny"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "npm install": "ask",
      "npm run *": "allow",
      "npm test *": "allow",
      "taskforge *": "allow",
      "npm run dev -- *": "allow",
      "git *": "deny",
      "sed *../task-state*": "deny",
      "perl *../task-state*": "deny",
      "python *../task-state*": "deny",
      "node *../task-state*": "deny",
      "tee *../task-state*": "deny",
      "echo *../task-state*": "deny",
      "rm *../task-state*": "deny",
      "mv *../task-state*": "deny",
      "cp *../task-state*": "deny"
    },
    "external_directory": {
      "../task-state/**": "allow",
      "../worktrees/**": "allow"
    }
  }
}