{
  "project": {
    "name": "task-forge",
    "defaultBranch": "main"
  },
  "tasks": {
    "stateDir": "../task-state"
  },
  "worktrees": {
    "root": "../worktrees"
  },
  "github": {
    "enabled": true,
    "owner": "squoyster",
    "repo": "task-forge",
    "labels": {
      "task": "taskforge",
      "blocked": "blocked",
      "agentReady": "agent-ready"
    }
  },
  "opencode": {
    "enabled": true,
    "command": "opencode",
    "policy": "managed",
    "audit": true,
    "guard": true,
    "policyVersion": 1
  },
  "continuation": {
    "autoContinue": true,
    "maxTaskFixIterations": 3
  },
  "dependencies": {
    "enabled": true,
    "packageManager": "npm"
  }
}
